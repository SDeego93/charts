<script>
(function(){
  function init(){
    var root=document.getElementById('smoobu-europe-market');
    if(!root||root.dataset.initialized==='1')return;
    root.dataset.initialized='1';
    var cities=[
  {id:"1",name:"London",country:"United Kingdom",lat:51.5074,lon:-0.1278,listings:49166,adr:176},
  {id:"2",name:"Paris",country:"France",lat:48.8566,lon:2.3522,listings:45098,adr:164},
  {id:"3",name:"Rome",country:"Italy",lat:41.9028,lon:12.4964,listings:28034,adr:146},
  {id:"4",name:"Madrid",country:"Spain",lat:40.4168,lon:-3.7038,listings:17235,adr:119},
  {id:"5",name:"Milan",country:"Italy",lat:45.4642,lon:9.19,listings:16976,adr:131},
  {id:"6",name:"Istanbul",country:"Türkiye",lat:41.0082,lon:28.9784,listings:13076,adr:63},
  {id:"7",name:"Lisbon",country:"Portugal",lat:38.7223,lon:-9.1393,listings:13019,adr:114},
  {id:"8",name:"Athens",country:"Greece",lat:37.9838,lon:23.7275,listings:12626,adr:81},
  {id:"9",name:"Barcelona",country:"Spain",lat:41.3874,lon:2.1686,listings:11380,adr:168},
  {id:"10",name:"Budapest",country:"Hungary",lat:47.4979,lon:19.0402,listings:11178,adr:70},
  {id:"11",name:"Florence",country:"Italy",lat:43.7696,lon:11.2558,listings:10884,adr:150},
  {id:"12",name:"Marseille",country:"France",lat:43.2965,lon:5.3698,listings:9738,adr:101},
  {id:"13",name:"Nice",country:"France",lat:43.7102,lon:7.262,listings:9444,adr:132},
  {id:"14",name:"Porto",country:"Portugal",lat:41.1579,lon:-8.6291,listings:9172,adr:90},
  {id:"15",name:"Copenhagen",country:"Denmark",lat:55.6761,lon:12.5683,listings:9147,adr:181},
  {id:"16",name:"Warsaw",country:"Poland",lat:52.2297,lon:21.0122,listings:8980,adr:75},
  {id:"17",name:"Vienna",country:"Austria",lat:48.2082,lon:16.3738,listings:8889,adr:112},
  {id:"18",name:"Prague",country:"Czechia",lat:50.0755,lon:14.4378,listings:8551,adr:99},
  {id:"19",name:"Naples",country:"Italy",lat:40.8518,lon:14.2681,listings:8134,adr:97},
  {id:"20",name:"Málaga",country:"Spain",lat:36.7213,lon:-4.4214,listings:8041,adr:122},
    ];
    var $=function(id){return root.querySelector('#'+id)};
    var number=function(n){return Number(n).toLocaleString('en-US')};
    var source='https://airbtics.com/best-airbnb-markets-europe';
    var selected='1',mode='listings',sort='listings';
    var latmin=33,latmax=72,lonmin=-14.5,lonmax=40;
    function merc(lat){return Math.log(Math.tan(Math.PI/4+lat*Math.PI/360))}
    function x(lon){return 26+(lon-lonmin)/(lonmax-lonmin)*908}
    function y(lat){return 21+(merc(latmax)-merc(lat))/(merc(latmax)-merc(latmin))*545}
    var NS='http://www.w3.org/2000/svg';
    var map=$('sem-pins');
    function make(tag){return document.createElementNS(NS,tag)}
    var maxCounts=Math.max.apply(null,cities.map(function(c){return c.listings}));
    var minRates=Math.min.apply(null,cities.map(function(c){return c.adr}));
    var maxRates=Math.max.apply(null,cities.map(function(c){return c.adr}));
    function radius(c){return mode==='listings' ? 6+15*Math.sqrt(c.listings/maxCounts) : 7+13*(c.adr-minRates)/(maxRates-minRates)}
    cities.forEach(function(c){
      var g=make('g');g.setAttribute('class','sem-pin');g.setAttribute('data-id',c.id);
      g.setAttribute('role','button');g.setAttribute('tabindex','0');
      g.setAttribute('aria-label',c.name+', '+number(c.listings)+' listings; average daily rate €'+c.adr);
      g.setAttribute('transform','translate('+x(c.lon).toFixed(1)+' '+y(c.lat).toFixed(1)+')');
      var halo=make('circle');halo.setAttribute('class','sem-halo');halo.setAttribute('r',radius(c)+4);
      var circle=make('circle');circle.setAttribute('class','sem-core');circle.setAttribute('r',radius(c));
      var title=make('title');title.textContent=c.name+' · '+number(c.listings)+' listings · €'+c.adr+' ADR';
      g.appendChild(halo);g.appendChild(circle);g.appendChild(title);map.appendChild(g);
      g.addEventListener('click',function(){select(c.id)});
      g.addEventListener('keydown',function(e){if(e.key==='Enter'||e.key===' '){e.preventDefault();select(c.id)}});
    });
    var pick=$('sem-city');
    cities.forEach(function(c){var o=document.createElement('option');o.value=c.id;o.textContent=c.name+' · '+c.country;pick.appendChild(o)});
    function repaint(){
      map.querySelectorAll('.sem-pin').forEach(function(g){var c=cities.find(function(z){return z.id===g.getAttribute('data-id')});var r=radius(c);g.querySelector('.sem-halo').setAttribute('r',(r+4).toFixed(1));g.querySelector('.sem-core').setAttribute('r',r.toFixed(1));g.classList.toggle('is-selected',c.id===selected)});
      $('sem-legendmetric').textContent=mode==='listings'?'listing count':'average daily rate (ADR)';
    }
    function drawList(){
      var ordered=cities.slice().sort(function(a,b){return b[sort]-a[sort]});
      var parent=$('sem-list');parent.replaceChildren();
      ordered.forEach(function(c,i){
        var b=document.createElement('button');b.type='button';b.className='sem-listitem';b.setAttribute('aria-current',String(c.id===selected));
        var rank=document.createElement('span');rank.className='sem-order';rank.textContent=String(i+1).padStart(2,'0');
        var label=document.createElement('span');label.className='sem-citytext';label.textContent=c.name;
        var val=document.createElement('span');val.className='sem-citynumber';val.textContent=sort==='listings'?number(c.listings):'€'+c.adr;
        b.appendChild(rank);b.appendChild(label);b.appendChild(val);b.addEventListener('click',function(){select(c.id)});parent.appendChild(b);
      });
    }
    function select(id){
      var c=cities.find(function(z){return z.id===String(id)});if(!c)return;
      selected=c.id;pick.value=c.id;
      $('sem-name').textContent=c.name;$('sem-country').textContent=c.country;
      $('sem-rank').textContent='#'+(cities.findIndex(function(z){return z.id===c.id})+1)+' by listings';
      $('sem-listings').textContent=number(c.listings);$('sem-adr').textContent='€'+c.adr;
      $('sem-description').textContent='Airbtics estimates '+number(c.listings)+' active Airbnb listings in the '+c.name+' market, with an average daily rate of €'+c.adr+' across January–December 2025. Figures reflect its market definition and model.';
      $('sem-source').href=source;
      // Outline the country containing the selected city.
      var countryName=c.country==='Türkiye'?'Turkey':c.country;
      root.querySelectorAll('#sem-map .sem-country').forEach(function(path){
        path.classList.toggle('sem-country-selected',path.getAttribute('data-country')===countryName);
      });
      repaint();drawList();
    }
    pick.addEventListener('change',function(){select(this.value)});
    $('sem-metric').addEventListener('change',function(){mode=this.value;repaint()});
    $('sem-sort').addEventListener('change',function(){sort=this.value;drawList()});
    select('1');
  }
  if(document.readyState==='loading'){document.addEventListener('DOMContentLoaded',init)}else{init()}
})();
</script>
